/health.json
  Cache-Control: no-store

/channels/*
  Cache-Control: no-cache

/releases/*
  Cache-Control: public, max-age=31536000, immutable

/v2/catalog.bin
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/octet-stream
/v2/releases/*
  Cache-Control: public, max-age=31536000, immutable
/v3/catalog.bin
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/octet-stream
/v3/releases/*
  Cache-Control: public, max-age=31536000, immutable
